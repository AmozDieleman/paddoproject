// Change to &htim8, TIM_CHANNEL_1 for module LED's
// Optimize with DMA?
void leds_on(void) {
	for (int i = 0; i < 200; i++) {
		__HAL_TIM_SET_COMPARE(&htim8, TIM_CHANNEL_1, i * i);
		__HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, i * i);
		HAL_Delay(3);
	}
}

void leds_off(void) {
	for (int i = 200; i > 0; i--) {
		__HAL_TIM_SET_COMPARE(&htim8, TIM_CHANNEL_1, i * i);
		__HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, i * i);
		HAL_Delay(30);
	}
}
